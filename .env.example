# Copy this file to .env and replace the password with a unique secret.
POSTGRES_DB=market_signal_scanner
POSTGRES_USER=mss_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Leave all Kite values empty until the account and Kite Connect app are active.
# Never commit the real .env file or share API secrets/access tokens.
KITE_MARKET_DATA_ENABLED=false
SCANNER_STRATEGY_ENABLED=true
SCANNER_CANDLE_INTERVAL=FIVE_MINUTE
KITE_STALE_TICK_SECONDS=20
KITE_RECONNECT_DELAY_SECONDS=3
# Keep false for normal development. Set true only for a deliberate, reviewed live-routing test.
KITE_ORDER_ROUTING_ENABLED=false
EXECUTION_STATUS_POLL_MS=5000
# Keep automated signal-to-order routing disabled until separately reviewed.
AUTOMATED_EXECUTION_ENABLED=false
AUTOMATED_MAX_SIGNAL_AGE_SECONDS=60
AUTOMATED_MAX_ORDER_QUANTITY=1
AUTOMATED_ORDER_TYPE=LIMIT
MARKET_SESSION_NEW_ENTRY_START=09:30
MARKET_SESSION_NEW_ENTRY_CUTOFF=14:45
MARKET_SESSION_CANCEL_PENDING_AT=14:55
MARKET_SESSION_SQUARE_OFF_AT=15:00
MARKET_SESSION_HARD_FLAT_DEADLINE=15:03
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8080/api/v1/integrations/zerodha/callback
# Optional. The documented Kite streaming endpoint is used by default.
KITE_WEBSOCKET_BASE_URL=wss://ws.kite.trade
# Generate with: openssl rand -base64 32. Keep stable across restarts; never commit the real value.
KITE_SESSION_ENCRYPTION_KEY=replace-with-base64-32-byte-key
